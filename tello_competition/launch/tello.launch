<launch>
  <arg name="seed" default="11" />
  <arg name="gui" default="true" />
  <arg name="camera_preview" default="false" />
  <arg name="verbose" default="false" />
  <!-- Resolve paths in both source workspaces and catkin install spaces. -->
  <env name="GAZEBO_MODEL_PATH" value="$(find tello_competition)/models:$(optenv GAZEBO_MODEL_PATH)" />
  <env name="GAZEBO_PLUGIN_PATH" value="$(find tello_px4_runtime)/runtime/lib:$(optenv GAZEBO_PLUGIN_PATH)" />
  <env name="LD_LIBRARY_PATH" value="$(find tello_px4_runtime)/runtime/lib:$(optenv LD_LIBRARY_PATH)" />
  <env name="GEOGRAPHICLIB_DATA" value="$(find tello_px4_runtime)/runtime/geographiclib" />
  <env name="GAZEBO_MODEL_DATABASE_URI" value="" />
  <param name="/use_sim_time" value="true" />
  <param name="/final/seed" value="$(arg seed)" type="int" />
  <param name="/final/drone_name" value="tello" />
  <param name="/final/vehicle_model" value="tello" />
  <rosparam command="load" file="$(find tello_competition)/config/tello_arena.yaml" />
  <rosparam command="load" file="$(find tello_competition)/config/tello_scaled_rules.yaml" />
  <node name="sitl" pkg="tello_px4_runtime" type="px4_node.py" output="screen" required="true" />
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find tello_competition)/worlds/tello_final.world" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="verbose" value="$(arg verbose)" />
    <arg name="server_required" value="true" />
    <arg name="gui_required" value="true" />
  </include>
  <node name="tello_spawn" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-sdf -file $(find tello_competition)/models/tello_training/model_camera.sdf -model tello -x -1.13 -y -1.13 -z 0.04 -Y 1.5707963267948966" />
  <include file="$(find mavros)/launch/px4.launch">
    <arg name="gcs_url" value="" />
    <arg name="fcu_url" value="udp://:14540@localhost:14557" />
  </include>
  <node pkg="tello_competition" type="gazebo_truth.py" name="gazebo_truth" output="screen">
    <param name="model" value="tello" />
  </node>
  <node pkg="tello_competition" type="final_scene.py" name="final_scene" output="screen" required="true" />
  <node pkg="tello_competition" type="final_judge.py" name="final_judge" output="screen" required="true" />
  <node pkg="tello_competition" type="student_bridge.py" name="student_bridge" output="screen" required="true" />
  <node pkg="tf" type="static_transform_publisher" name="tello_camera_tf"
        args="0.036 0 0.005 -1.57079632679 0 -1.57079632679 tello/base_link tello/front_camera_optical 100" />
  <node if="$(arg camera_preview)" pkg="tello_competition" type="camera_preview.py" name="camera_preview" output="screen" />
</launch>
