#!/bin/sh
# Project-local 85 g Tello-shaped simulation. Uncalibrated engineering model.
. ${R}etc/init.d/rc.mc_defaults
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4
# PX4 FRD: y has opposite sign to the Gazebo FLU motor coordinates.
param set-default CA_ROTOR0_PX 0.0425
param set-default CA_ROTOR0_PY 0.05
param set-default CA_ROTOR0_KM 0.008
param set-default CA_ROTOR1_PX -0.0425
param set-default CA_ROTOR1_PY -0.05
param set-default CA_ROTOR1_KM 0.008
param set-default CA_ROTOR2_PX 0.0425
param set-default CA_ROTOR2_PY -0.05
param set-default CA_ROTOR2_KM -0.008
param set-default CA_ROTOR3_PX -0.0425
param set-default CA_ROTOR3_PY 0.05
param set-default CA_ROTOR3_KM -0.008
param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104
param set-default MC_ROLLRATE_K 0.3
param set-default MC_PITCHRATE_K 0.3
param set-default MC_YAWRATE_K 0.3
param set-default MPC_THR_HOVER 0.548
param set-default MPC_THR_MIN 0.06
param set-default MPC_LAND_SPEED 0.2
param set-default LNDMC_Z_VEL_MAX 0.15
